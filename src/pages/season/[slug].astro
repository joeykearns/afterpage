---
import Base from '../../layouts/Base.astro';
import { seasonHubs, unitLabel, shortAnswer } from '../../lib/series.mjs';

export function getStaticPaths() {
  return seasonHubs().map((hub) => ({ params: { slug: hub.slug }, props: { hub } }));
}
const { hub } = Astro.props;
const allAiring = hub.items.every((i) => i.entry.airing);
---
<Base
  title={`${hub.label} anime: where to start the manga`}
  description={`Every ${hub.label} anime we cover, with the chapter to start reading next. Numbers only, no spoilers.`}
>
  <p class="crumb"><a href="/#seasons">All seasons</a></p>
  <h1 class="hub-title">{hub.label}</h1>
  <p class="muted sub">{allAiring
    ? "These are airing now. We add each show's starting chapter within 48 hours of its finale."
    : `Finished something from ${hub.label}? Here's where each one picks up.`}</p>
  <ul class="rows list">
    {hub.items.map(({ series: s, entry: e }) => (
      <li>
        <a href={`/anime/${s.slug}/${e.id}`}>
          <span><span class="row-title">{s.title}</span><br /><span class="row-sub">{e.airing ? e.label : `After ${e.label}`}</span></span>
          {e.airing
            ? <span class="row-pending">Airing</span>
            : <span class="row-answer">{shortAnswer(s, e)}</span>}
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .crumb { font-size: 0.92rem; color: var(--ink-soft); margin-top: 8px; }
  .hub-title { font-size: clamp(2rem, 7vw, 3rem); margin-top: 10px; }
  .sub { margin-top: 8px; }
  .list { margin-top: 24px; }
</style>
