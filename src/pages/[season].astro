---
// One page per season, part or film, so each can rank for searches like
// "Jujutsu Kaisen season 3 where to start manga".
import Base from '../../../layouts/Base.astro';
import AnswerCard from '../../../components/AnswerCard.astro';
import AiringCard from '../../../components/AiringCard.astro';
import ReadOfficial from '../../../components/ReadOfficial.astro';
import { loadAllSeries, airedKey, airedLabel, sourceLabel, unitLabel } from '../../../lib/series.mjs';

export function getStaticPaths() {
  return loadAllSeries().flatMap((series) =>
    series.entries.map((entry) => ({ params: { slug: series.slug, season: entry.id }, props: { series, entry } })),
  );
}

const { series, entry } = Astro.props;
const others = [...series.entries].filter((e) => e.id !== entry.id).sort((a, b) => airedKey(b.aired) - airedKey(a.aired));
const earlierFinished = series.entries.some((e) => !e.airing && e.id !== entry.id);
const source = sourceLabel(series.source).toLowerCase();
const unit = unitLabel(series.source);
const answer = entry.airing ? null : `${unit} ${entry.start_chapter}`;

const title = entry.airing
  ? `${series.title} ${entry.label}: where to start the ${source} (airing now)`
  : `${series.title} ${entry.label}: where to start the ${source} (${answer})`;
const description = entry.airing
  ? `${series.title} ${entry.label} is airing now. We add the exact ${source} ${unit.toLowerCase()} to start within 48 hours of the finale. No spoilers.`
  : `Finished ${series.title} ${entry.label}? Start the ${source} at ${answer}${entry.start_volume ? ` (Volume ${entry.start_volume})` : ''}. Numbers only, no spoilers, sources linked.`;

const faq = !entry.airing && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: `Where do I start the ${source} after ${series.title} ${entry.label}?`,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `Start at ${unit.toLowerCase()} ${entry.start_chapter}${entry.start_volume ? ` (volume ${entry.start_volume})` : ''}.`,
    },
  }],
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'All shows', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: series.title, item: new URL(`/anime/${series.slug}`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: entry.label },
  ],
};
---
<Base title={title} description={description} image={`/og/${series.slug}/${entry.id}.png`}>
  {faq && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faq)} />}
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbs)} />

  <nav class="crumb" aria-label="Breadcrumb">
    <a href="/">All shows</a> <span aria-hidden="true">/</span> <a href={`/anime/${series.slug}`}>{series.title}</a>
  </nav>

  <header class="season-head">
    <h1><span class="h1-show">{series.title}</span> {entry.label}: where to start the {source}</h1>
  </header>

  {entry.airing
    ? <AiringCard series={series} entry={entry} hasEarlier={earlierFinished} headingLevel={2} />
    : <AnswerCard series={series} entry={entry} headingLevel={2} />}

  {others.length > 0 && (
    <section class="section" aria-labelledby="other-h">
      <h2 id="other-h">Other seasons</h2>
      <ul class="rows">
        {others.map((e) => (
          <li>
            <a href={`/anime/${series.slug}/${e.id}`}>
              <span><span class="row-title">{e.label}</span><br /><span class="row-sub">{airedLabel(e.aired)}</span></span>
              {e.airing
                ? <span class="row-pending">Airing</span>
                : <span class="row-answer">{unit === 'Volume' ? 'Vol.' : 'Ch.'} {e.start_chapter}</span>}
            </a>
          </li>
        ))}
      </ul>
      <p class="all-link"><a href={`/anime/${series.slug}`}>See every {series.title} answer on one page</a></p>
    </section>
  )}

  <ReadOfficial series={series} />
</Base>

<style>
  .crumb { font-size: 0.92rem; color: var(--ink-soft); margin-top: 8px; display: flex; gap: 6px; flex-wrap: wrap; }
  .season-head { margin-top: 16px; }
  .h1-show { display: block; font-size: 0.5em; font-weight: 700; letter-spacing: 0; color: var(--ink-soft); margin-bottom: 6px; font-family: var(--body); }
  .season-head h1 { font-size: clamp(2rem, 7vw, 3rem); margin-top: 6px; }
  .all-link { margin-top: 14px; font-size: 0.95rem; }
</style>
