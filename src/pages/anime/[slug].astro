---
import Base from '../../layouts/Base.astro';
import AnswerCard from '../../components/AnswerCard.astro';
import AiringCard from '../../components/AiringCard.astro';
import ReadOfficial from '../../components/ReadOfficial.astro';
import { loadAllSeries, airedKey, sourceLabel, unitLabel, latestAnswer, answerKey } from '../../lib/series.mjs';

export function getStaticPaths() {
  return loadAllSeries().map((series) => ({ params: { slug: series.slug }, props: { series } }));
}

const { series } = Astro.props;
const entries = [...series.entries].sort((a, b) => airedKey(b.aired) - airedKey(a.aired));
const finished = entries.filter((e) => !e.airing);
const latest = latestAnswer(series);
const unit = unitLabel(series.source);
const source = sourceLabel(series.source).toLowerCase();
const title = `${series.title}: where to start the ${source} after the anime`;
const description = `The ${source} chapter to start after each season of ${series.title}. Numbers only, no spoilers. Sources linked.`;

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: finished.map((e) => ({
    '@type': 'Question',
    name: `Where do I start the ${source} after ${series.title} ${e.label}?`,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `Start at chapter ${e.start_chapter}${e.start_volume ? ` (volume ${e.start_volume})` : ''}.`,
    },
  })),
};
---
<Base title={title} description={description} image={`/og/${series.slug}.png`}>
  {finished.length > 0 && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faq)} />}

  <p class="crumb"><a href="/">All shows</a></p>
  <header class="series-head">
    <div class="head-row">
      <p class="format">{sourceLabel(series.source)}</p>
      <button class="save" type="button" data-slug={series.slug} data-key={answerKey(series)} aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8Z" /></svg>
        <span class="save-label">Save to My shows</span>
      </button>
    </div>
    <h1 class="series-title">{series.title}</h1>
    {series.aka.length > 0 && <p class="muted aka">Also known as {series.aka.join(', ')}</p>}
    {latest && (
      <p class="summary">
        Finished <a href={`#${latest.id}`}>{latest.label}</a>? Start at <strong>{unit} {latest.start_chapter}</strong>.
      </p>
    )}
    {finished.some((e) => e.episode_map) && (
      <p class="muted hint">Stopped mid-season? Each season below has an episode finder.</p>
    )}
  </header>

  {entries.length > 1 && (
    <nav class="jump" aria-label="Pick what you just finished">
      <p>Which one are you on?</p>
      <ul>
        {entries.map((e) => (<li><a href={`#${e.id}`}>{e.label}</a></li>))}
      </ul>
    </nav>
  )}

  {entries.map((entry) =>
    entry.airing
      ? <AiringCard series={series} entry={entry} hasEarlier={finished.length > 0} permalink={`/anime/${series.slug}/${entry.id}`} />
      : <AnswerCard series={series} entry={entry} permalink={`/anime/${series.slug}/${entry.id}`} />
  )}

  <ReadOfficial series={series} />
</Base>

<script>
  // "My shows": saved in this browser only. No account, nothing sent anywhere.
  const STORE = 'afterpage.myShows';
  const read = (): Record<string, { seen: string; added: string }> => {
    try { return JSON.parse(localStorage.getItem(STORE) || '{}') || {}; } catch { return {}; }
  };
  const write = (v: object) => { try { localStorage.setItem(STORE, JSON.stringify(v)); return true; } catch { return false; } };
  const btn = document.querySelector<HTMLButtonElement>('button.save');
  if (btn) {
    const slug = btn.dataset.slug!;
    const key = btn.dataset.key!;
    const render = (saved: boolean) => {
      btn.setAttribute('aria-pressed', String(saved));
      btn.querySelector('.save-label')!.textContent = saved ? 'Saved to My shows' : 'Save to My shows';
    };
    const shows = read();
    if (shows[slug]) {
      // Visiting the page counts as having seen the latest answer.
      shows[slug].seen = key;
      write(shows);
    }
    render(Boolean(shows[slug]));
    btn.addEventListener('click', () => {
      const s = read();
      if (s[slug]) delete s[slug];
      else s[slug] = { seen: key, added: new Date().toISOString().slice(0, 10) };
      if (!write(s)) { btn.querySelector('.save-label')!.textContent = "Couldn't save in this browser"; return; }
      render(Boolean(s[slug]));
    });
  }
</script>

<style>
  .crumb { font-size: 0.92rem; color: var(--ink-soft); margin-top: 8px; }
  .series-head { margin-top: 14px; }
  .head-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .save {
    display: inline-flex; align-items: center; gap: 8px;
    font: inherit; font-size: 0.92rem; font-weight: 700;
    padding: 7px 14px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--glass-edge); background: var(--glass); color: var(--ink);
  }
  .save:hover { border-color: var(--ink-soft); }
  .save svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
  .save[aria-pressed='true'] { border-color: var(--ribbon); }
  .save[aria-pressed='true'] svg { fill: var(--ribbon); stroke: var(--ribbon); }
  .format {
    display: inline-block; font-size: 0.85rem; font-weight: 700;
    padding: 2px 10px; border-radius: 999px; border: 1.5px solid var(--ink);
  }
  .series-title { font-size: clamp(2.2rem, 8vw, 3.4rem); margin-top: 12px; }
  .aka { margin-top: 8px; }
  .summary { margin-top: 14px; font-size: 1.1rem; }
  .hint { margin-top: 6px; font-size: 0.95rem; }
  .summary strong { font-family: var(--display); font-weight: 600; white-space: nowrap; }
  .jump { margin-top: 28px; }
  .jump p { font-weight: 700; margin-bottom: 8px; }
  .jump ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a {
    display: inline-block; padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--glass-edge); background: var(--glass);
    text-decoration: none; font-size: 0.95rem;
  }
  .jump a:hover { border-color: var(--ink); }
</style>
