---
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import * as config from '../config.mjs';

const { SITE_NAME, SITE_URL } = config;
// Optional settings in config.mjs (safe to leave out):
const googleVerification = config.GOOGLE_SITE_VERIFICATION || '';
const analyticsToken = config.CLOUDFLARE_ANALYTICS_TOKEN || '';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
}
const { title, description, path = Astro.url.pathname, image = '/og.png' } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;
const fullTitle = title === SITE_NAME ? `${SITE_NAME}: the exact manga chapter to start next` : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: the exact chapter to start after the anime`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#EEF1F8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1020" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: new chapter answers`} href="/feed.xml" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <link rel="preload" href="/digits.woff2" as="font" type="font/woff2" crossorigin />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
          <img class="brand-mark" src="/logo-mark.png" width="66" height="41" alt="" />
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label="Main">
          <a href="/shows">All shows</a>
          <a href="/about">How we check</a>
          <a href="/submit">Add a show</a>
          <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch light or dark">
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">
          <img class="brand-mark" src="/logo-mark.png" width="46" height="29" alt="" />
          {SITE_NAME}
        </p>
        <p>Numbers only, never plot. Every answer links its sources, and we only point to official releases.</p>
        <p>Something wrong or missing? <a href="/submit">Tell us</a>, or read <a href="/about">how we check answers</a>. Follow new answers with the <a href="/feed.xml">RSS feed</a>.</p>
      </div>
    </footer>
    {analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>
    )}
    <script>
      // Theme switch: remembers the choice in this browser.
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const label = () => btn?.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
      label();
      btn?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        label();
      });

      // Press "/" anywhere to search.
      document.addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement;
        if (t && (t.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName))) return;
        e.preventDefault();
        const q = document.getElementById('q') as HTMLInputElement | null;
        if (q) { q.focus(); q.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
        else location.href = '/#search';
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #EEF1F8;
    --sheet: #FFFFFF;
    --panel: rgba(236, 240, 248, 0.78);
    --glass: rgba(255, 255, 255, 0.56);
    --glass-edge: rgba(255, 255, 255, 0.85);
    --glass-shine: rgba(255, 255, 255, 0.7);
    --ink: #20283D;
    --ink-soft: #505A73;
    --rule: #D3D9E6;
    --hover: rgba(32, 40, 61, 0.06);
    --ribbon: #D9473F;
    --ribbon-ink: #FFFFFF;
    --badge: #C63D35;
    --badge-ink: #FFFFFF;
    --tone: rgba(32, 40, 61, 0.13);
    --focus: #3D5AFE;
    --amber-bg: #FFF4D6;
    --amber-ink: #6B4A00;
    --glow-1: rgba(217, 71, 63, 0.24);
    --glow-2: rgba(84, 110, 240, 0.26);
    --glow-3: rgba(32, 40, 61, 0.10);
    --shadow: 0 1px 2px rgba(32, 40, 61, 0.05), 0 14px 36px -18px rgba(32, 40, 61, 0.32);
    --display: 'Rubik', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --body: 'Site Digits', 'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color-scheme: light;
  }
  :root[data-theme='dark'] {
    color-scheme: dark;
    --paper: #0B1020;
    --sheet: #161D31;
    --panel: rgba(9, 13, 26, 0.5);
    --glass: rgba(26, 33, 54, 0.55);
    --glass-edge: rgba(255, 255, 255, 0.1);
    --glass-shine: rgba(255, 255, 255, 0.06);
    --ink: #E9EDF6;
    --ink-soft: #A7B0C8;
    --rule: #2B3452;
    --hover: rgba(233, 237, 246, 0.07);
    --ribbon: #F05B50;
    --ribbon-ink: #1A0806;
    --badge: #F05B50;
    --badge-ink: #1A0806;
    --tone: rgba(233, 237, 246, 0.1);
    --focus: #8EA6FF;
    --amber-bg: #3A2F12;
    --amber-ink: #F2D48A;
    --glow-1: rgba(240, 91, 80, 0.22);
    --glow-2: rgba(84, 110, 240, 0.26);
    --glow-3: rgba(120, 90, 220, 0.12);
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 16px 40px -18px rgba(0, 0, 0, 0.75);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --paper: #0B1020;
      --sheet: #161D31;
      --panel: rgba(9, 13, 26, 0.5);
      --glass: rgba(26, 33, 54, 0.55);
      --glass-edge: rgba(255, 255, 255, 0.1);
      --glass-shine: rgba(255, 255, 255, 0.06);
      --ink: #E9EDF6;
      --ink-soft: #A7B0C8;
      --rule: #2B3452;
      --hover: rgba(233, 237, 246, 0.07);
      --ribbon: #F05B50;
      --ribbon-ink: #1A0806;
      --badge: #F05B50;
      --badge-ink: #1A0806;
    --badge: #F05B50;
    --badge-ink: #1A0806;
      --tone: rgba(233, 237, 246, 0.1);
      --focus: #8EA6FF;
      --amber-bg: #3A2F12;
      --amber-ink: #F2D48A;
      --glow-1: rgba(240, 91, 80, 0.22);
      --glow-2: rgba(84, 110, 240, 0.26);
      --glow-3: rgba(120, 90, 220, 0.12);
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 16px 40px -18px rgba(0, 0, 0, 0.75);
    }
  }
  @font-face {
    font-family: 'Site Digits';
    src: url('/digits.woff2') format('woff2');
    font-weight: 200 800;
    font-display: swap;
    unicode-range: U+0030-0039;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    position: relative;
    isolation: isolate;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  /* Soft color glow behind everything, so the frosted-glass cards have something to blur. */
  body::before {
    content: '';
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(38rem 30rem at 88% -6%, var(--glow-1), transparent 70%),
      radial-gradient(42rem 34rem at -8% 28%, var(--glow-2), transparent 70%),
      radial-gradient(36rem 30rem at 60% 108%, var(--glow-3), transparent 70%);
  }

  /* Frosted glass: shared by cards and panels. Falls back to a solid surface where blur isn't supported. */
  .glass, :where(.answer, .hero-panel, .choice, .site-footer) {
    background: var(--glass);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid var(--glass-edge);
    box-shadow: inset 0 1px 0 var(--glass-shine), var(--shadow);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass, :where(.answer, .hero-panel, .choice, .site-footer) { background: var(--sheet); }
  }

  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  h1, h2, h3 { font-family: var(--display); font-weight: 600; line-height: 1.08; letter-spacing: -0.015em; margin: 0; text-wrap: balance; }
  p { margin: 0; text-wrap: pretty; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 12px; background: var(--sheet); padding: 8px 12px; z-index: 10; }

  .bar, main, .footer-inner { width: min(760px, 100% - 32px); margin-inline: auto; }

  .site-header { border-top: 3px solid var(--ribbon); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; padding: 18px 0; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 12px; font-family: var(--display); font-weight: 600; font-size: 1.3rem; letter-spacing: -0.01em; text-decoration: none; }
  .brand-mark { width: 66px; height: auto; flex: none; }
  @media (max-width: 480px) { .site-header .brand-mark { width: 56px; } }
  .bar nav { display: flex; gap: 4px; font-size: 0.95rem; margin-inline: -10px; }
  .bar nav a { text-decoration: none; color: var(--ink-soft); padding: 6px 10px; border-radius: 8px; }
  .bar nav a:hover { color: var(--ink); background: var(--hover); }
  .theme-toggle {
    display: inline-grid; place-items: center; width: 36px; height: 36px; margin-left: 4px;
    border: 1px solid var(--glass-edge); border-radius: 999px; background: var(--glass); color: var(--ink-soft); cursor: pointer;
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--ink-soft); }
  .theme-toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-sun { display: block; }
  :root[data-theme='dark'] .icon-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon-sun { display: block; }
    :root:not([data-theme='light']) .icon-moon { display: none; }
  }
  .bar nav { align-items: center; }

  main { padding-bottom: 72px; }

  .site-footer { border-width: 1px 0 0; box-shadow: inset 0 1px 0 var(--glass-shine); }
  .footer-inner { padding: 28px 0 44px; color: var(--ink-soft); font-size: 0.9rem; display: grid; gap: 8px; }
  .footer-brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 600; color: var(--ink); font-size: 1.05rem; margin-bottom: 4px; }
  .footer-brand .brand-mark { width: 36px; }

  .muted { color: var(--ink-soft); }
  .section { margin-top: 56px; }
  .section h2 { font-size: 1.4rem; margin-bottom: 14px; }

  /* Lists of results: title left, answer right */
  .rows { list-style: none; margin: 0 -12px; padding: 0; }
  .rows li + li { border-top: 1px solid var(--rule); }
  .rows a {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 12px; border-radius: 10px; text-decoration: none;
    transition: background-color 120ms ease;
  }
  .rows a:hover { background: var(--hover); }
  .rows li:has(a:hover) + li, .rows li:has(+ li a:hover) { border-color: transparent; }
  .rows a:hover .row-title { text-decoration: underline; }
  .row-title { font-weight: 700; }
  .row-sub { color: var(--ink-soft); font-size: 0.92rem; }
  .row-answer {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--display); font-weight: 600; white-space: nowrap; font-size: 1.1rem; letter-spacing: 0;
  }
  .row-answer::before {
    content: ''; width: 9px; height: 13px; background: var(--ribbon);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
  }
  .row-pending { color: var(--ink-soft); white-space: nowrap; font-size: 0.9rem; border: 1px dashed var(--ink-soft); border-radius: 999px; padding: 2px 10px; }

  .chip-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip-list a {
    display: inline-block; padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--glass-edge); background: var(--glass); text-decoration: none; font-size: 0.95rem;
    transition: border-color 120ms ease;
  }
  .chip-list a:hover { border-color: var(--ink); }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
