---
import { SITE_NAME, SITE_URL } from '../config.mjs';

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = Astro.url.pathname } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="google-site-verification" content="M_fMmrKgabGGSgN7g6Tvkw_We1_AG6Zimm5tp2TbAtY" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F3F4F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131417" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
        <svg class="brand-mark" viewBox="0 0 20 28" aria-hidden="true"><path d="M2 0h16v28l-8-6-8 6z" /></svg>
        <span>{SITE_NAME}</span>
      </a>
      <nav aria-label="Main">
        <a href="/#seasons">Seasons</a>
        <a href="/about">How we check</a>
        <a href="/submit">Add a show</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Numbers only, never plot. Every answer links its sources, and we only point to official releases.</p>
      <p>Something wrong or missing? <a href="/submit">Tell us</a>, or read <a href="/about">how we check answers</a>.</p>
    </footer>
  <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "6c357de60f144f08a1a19f858edbf37f"}'></script><!-- End Cloudflare Web Analytics -->
</body>
</html>

<style is:global>
  :root {
    --paper: #F3F4F6;
    --sheet: #FFFFFF;
    --ink: #17181C;
    --ink-soft: #545A66;
    --rule: #D9DCE2;
    --ribbon: #D7261E;
    --ribbon-ink: #FFFFFF;
    --tone: rgba(23, 24, 28, 0.13);
    --focus: #1D5FD1;
    --amber-bg: #FFF4D6;
    --amber-ink: #6B4A00;
    --display: 'Bricolage Grotesque', 'Arial Narrow', system-ui, sans-serif;
    --body: 'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #131417;
      --sheet: #1C1D22;
      --ink: #ECEDF0;
      --ink-soft: #A3A8B3;
      --rule: #32343B;
      --ribbon: #F2493F;
      --ribbon-ink: #16080A;
      --tone: rgba(236, 237, 240, 0.12);
      --focus: #7FA8FF;
      --amber-bg: #3A2F12;
      --amber-ink: #F2D48A;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  h1, h2, h3 { font-family: var(--display); font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; margin: 0; }
  p { margin: 0; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 12px; background: var(--sheet); padding: 8px 12px; z-index: 10; }

  .site-header, main, .site-footer { width: min(720px, 100% - 32px); margin-inline: auto; }
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; font-size: 1.25rem; text-decoration: none; }
  .brand-mark { width: 14px; height: 20px; fill: var(--ribbon); }
  .site-header nav { display: flex; gap: 18px; font-size: 0.95rem; }
  .site-header nav a { text-decoration: none; color: var(--ink-soft); }
  .site-header nav a:hover { color: var(--ink); text-decoration: underline; }
  main { padding-bottom: 64px; }
  .site-footer { border-top: 1px solid var(--rule); padding: 24px 0 40px; color: var(--ink-soft); font-size: 0.9rem; display: grid; gap: 6px; }

  .muted { color: var(--ink-soft); }
  .section { margin-top: 48px; }
  .section h2 { font-size: 1.35rem; margin-bottom: 14px; }

  /* Lists of results: title left, answer right */
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .rows li { border-bottom: 1px solid var(--rule); }
  .rows a { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 12px 2px; text-decoration: none; }
  .rows a:hover .row-title { text-decoration: underline; }
  .row-title { font-weight: 700; }
  .row-sub { color: var(--ink-soft); font-size: 0.92rem; }
  .row-answer { font-family: var(--display); font-weight: 800; white-space: nowrap; font-size: 1.05rem; }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
