---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import { SITE_NAME, SITE_URL } from '../config.mjs';

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = Astro.url.pathname } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL('/og.png', SITE_URL).href;
const fullTitle = title === SITE_NAME ? `${SITE_NAME}: where the anime leaves off in the manga` : `${title} | ${SITE_NAME}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: the exact chapter to start after the anime`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F3F4F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131417" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
          <svg class="brand-mark" viewBox="0 0 20 28" aria-hidden="true"><path d="M2 0h16v28l-8-6-8 6z" /></svg>
          <span>{SITE_NAME}</span>
        </a>
        <nav aria-label="Main">
          <a href="/#seasons">Seasons</a>
          <a href="/about">How we check</a>
          <a href="/submit">Add a show</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">
          <svg class="brand-mark" viewBox="0 0 20 28" aria-hidden="true"><path d="M2 0h16v28l-8-6-8 6z" /></svg>
          {SITE_NAME}
        </p>
        <p>Numbers only, never plot. Every answer links its sources, and we only point to official releases.</p>
        <p>Something wrong or missing? <a href="/submit">Tell us</a>, or read <a href="/about">how we check answers</a>.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #F3F4F6;
    --sheet: #FFFFFF;
    --ink: #17181C;
    --ink-soft: #545A66;
    --rule: #DADDE3;
    --hover: #E9EBEF;
    --ribbon: #D7261E;
    --ribbon-ink: #FFFFFF;
    --tone: rgba(23, 24, 28, 0.13);
    --focus: #1D5FD1;
    --amber-bg: #FFF4D6;
    --amber-ink: #6B4A00;
    --shadow: 0 1px 2px rgba(23, 24, 28, 0.06), 0 8px 24px -12px rgba(23, 24, 28, 0.18);
    --display: 'Bricolage Grotesque Variable', 'Arial Narrow', system-ui, sans-serif;
    --body: 'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #131417;
      --sheet: #1C1D22;
      --ink: #ECEDF0;
      --ink-soft: #A3A8B3;
      --rule: #32343B;
      --hover: #24262C;
      --ribbon: #F2493F;
      --ribbon-ink: #16080A;
      --tone: rgba(236, 237, 240, 0.12);
      --focus: #7FA8FF;
      --amber-bg: #3A2F12;
      --amber-ink: #F2D48A;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 10px 30px -14px rgba(0, 0, 0, 0.7);
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.0625rem;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  h1, h2, h3 { font-family: var(--display); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; margin: 0; text-wrap: balance; }
  p { margin: 0; text-wrap: pretty; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 12px; background: var(--sheet); padding: 8px 12px; z-index: 10; }

  .bar, main, .footer-inner { width: min(760px, 100% - 32px); margin-inline: auto; }

  .site-header { border-top: 4px solid var(--ribbon); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; padding: 18px 0; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; font-size: 1.3rem; letter-spacing: -0.02em; text-decoration: none; }
  .brand-mark { width: 14px; height: 20px; fill: var(--ribbon); flex: none; }
  .bar nav { display: flex; gap: 4px; font-size: 0.95rem; margin-inline: -10px; }
  .bar nav a { text-decoration: none; color: var(--ink-soft); padding: 6px 10px; border-radius: 8px; }
  .bar nav a:hover { color: var(--ink); background: var(--hover); }

  main { padding-bottom: 72px; }

  .site-footer { border-top: 1px solid var(--rule); background: var(--sheet); }
  .footer-inner { padding: 28px 0 44px; color: var(--ink-soft); font-size: 0.9rem; display: grid; gap: 8px; }
  .footer-brand { display: inline-flex; align-items: center; gap: 8px; font-family: var(--display); font-weight: 800; color: var(--ink); font-size: 1.05rem; margin-bottom: 4px; }
  .footer-brand .brand-mark { width: 11px; height: 16px; }

  .muted { color: var(--ink-soft); }
  .section { margin-top: 56px; }
  .section h2 { font-size: 1.4rem; margin-bottom: 14px; }

  /* Lists of results: title left, answer right */
  .rows { list-style: none; margin: 0 -12px; padding: 0; }
  .rows li + li { border-top: 1px solid var(--rule); }
  .rows a {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 12px; border-radius: 10px; text-decoration: none;
    transition: background-color 120ms ease;
  }
  .rows a:hover { background: var(--hover); }
  .rows li:has(a:hover) + li, .rows li:has(+ li a:hover) { border-color: transparent; }
  .rows a:hover .row-title { text-decoration: underline; }
  .row-title { font-weight: 700; }
  .row-sub { color: var(--ink-soft); font-size: 0.92rem; }
  .row-answer {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--display); font-weight: 800; white-space: nowrap; font-size: 1.1rem; letter-spacing: -0.01em;
  }
  .row-answer::before {
    content: ''; width: 9px; height: 13px; background: var(--ribbon);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
  }
  .row-pending { color: var(--ink-soft); white-space: nowrap; font-size: 0.9rem; border: 1px dashed var(--ink-soft); border-radius: 999px; padding: 2px 10px; opacity: 0.85; }

  .chip-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip-list a {
    display: inline-block; padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--rule); background: var(--sheet); text-decoration: none; font-size: 0.95rem;
    transition: border-color 120ms ease;
  }
  .chip-list a:hover { border-color: var(--ink); }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
