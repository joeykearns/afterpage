---
import { airedLabel, unitLabel } from '../lib/series.mjs';
import { feedbackUrl } from '../lib/feedback.mjs';

const { series, entry, permalink, headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}`;
const unit = unitLabel(series.source);
const kindText = entry.kind === 'movie' ? 'Film' : entry.episodes ? `Episodes ${entry.episodes}` : '';
const answerText = `${series.title}, after ${entry.label}: start at ${unit} ${entry.start_chapter}${entry.start_volume ? ` (Volume ${entry.start_volume})` : ''}`;

const trust = {
  agree: `${entry.sources.length} sources agree`,
  differ: 'Sources differ slightly, see the note',
  single: 'One source so far. Help us confirm it',
}[entry.confidence];

const checked = new Date(`${entry.last_checked}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const map = entry.episode_map;
const pickerData = map && JSON.stringify({
  rows: map.rows,
  firstEpisode: map.first_episode,
  unit,
  final: { start: entry.start_chapter, volume: entry.start_volume || null, overlap: entry.overlap || null },
});
const firstEp = map ? map.first_episode : 1;
const lastEp = map ? map.first_episode + map.rows.length - 1 : 1;

const reportUrl = feedbackUrl({ type: 'correction', show: series.title, season: entry.label });
---
<article class="answer" id={entry.id} aria-labelledby={`${entry.id}-h`}>
  <header class="answer-head">
    <H id={`${entry.id}-h`}>After {entry.label}</H>
    <p class="muted">{[kindText, airedLabel(entry.aired)].filter(Boolean).join(', ')}</p>
    {permalink && <a class="permalink" href={permalink}>Page for this {entry.kind === 'movie' ? 'film' : entry.kind === 'part' ? 'part' : 'season'}</a>}
  </header>

  <div class="start">
    <span class="ribbon" aria-hidden="true"></span>
    <p class="start-label">Start reading at</p>
    <p class="start-number"><span class="unit">{unit}</span> {entry.start_chapter}</p>
    {entry.start_volume && <p class="start-vol">Volume {entry.start_volume}</p>}
    <button class="copy" type="button" data-copy={answerText}>Copy answer</button>
  </div>

  {entry.overlap && (
    <p class="callout"><strong>Where it cuts off:</strong> {entry.overlap}</p>
  )}

  {map && (
    <div class="picker" data-picker={pickerData}>
      <p class="picker-title">Stopped partway through?</p>
      <form class="picker-form">
        <label for={`${entry.id}-ep`}>Last episode you watched</label>
        <div class="picker-row">
          <input id={`${entry.id}-ep`} type="number" inputmode="numeric" min="1" step="1" placeholder={firstEp > 1 ? `${firstEp}–${lastEp}` : `1–${lastEp}`} required />
          <button type="submit">Find my chapter</button>
        </div>
      </form>
      <p class="picker-result" aria-live="polite" hidden></p>
      <p class="picker-source">Episode data from <a href={map.source.url} rel="nofollow noopener" target="_blank">{map.source.name}</a>. The season's final answer is checked against the sources below.</p>
    </div>
  )}

  <dl class="facts">
    {entry.last_chapter != null && (<div><dt>Anime ends at</dt><dd>{unit} {entry.last_chapter}</dd></div>)}
    <div><dt>Skipped by the anime</dt><dd>{entry.skipped.length ? entry.skipped.join('; ') : 'Nothing we know of'}</dd></div>
  </dl>

  {entry.note && <p class="note">{entry.note}</p>}

  <div class="trust">
    <p><span class={`dot ${entry.confidence}`} aria-hidden="true"></span>{trust}. Last checked {checked}.</p>
    <details>
      <summary>Sources</summary>
      <ul>
        {entry.sources.map((s) => (<li><a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></li>))}
      </ul>
      <p class="muted small">Source pages may contain spoilers.</p>
    </details>
    <a class="report" href={reportUrl} rel="nofollow">This is wrong</a>
  </div>
</article>

<style>
  .answer {
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: clamp(20px, 5vw, 28px);
    box-shadow: var(--shadow);
    margin-top: 20px;
    scroll-margin-top: 16px;
  }
  .answer-head h2 { font-size: 1.4rem; }
  .answer-head p { margin-top: 4px; font-size: 0.95rem; }
  .answer-head { position: relative; }
  .answer-head :is(h2, h3) { font-size: 1.4rem; padding-right: 7.5rem; }
  .permalink { position: absolute; top: 4px; right: 0; font-size: 0.85rem; color: var(--ink-soft); }
  @media (max-width: 480px) {
    .answer-head :is(h2, h3) { padding-right: 0; }
    .permalink { position: static; display: inline-block; margin-top: 6px; }
  }

  .start {
    position: relative;
    margin: 20px 0 0;
    padding: 22px 22px 20px 64px;
    border-radius: 10px;
    background-color: var(--paper);
    background-image: radial-gradient(var(--tone) 1.1px, transparent 1.3px);
    background-size: 7px 7px;
    overflow: hidden;
  }
  .ribbon {
    position: absolute; left: 22px; top: 0;
    width: 22px; height: 64px;
    background: var(--ribbon);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }
  .start-label { font-weight: 700; }
  .start-number {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(3rem, 12vw, 4.75rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-top: 4px;
  }
  .unit { font-size: 0.42em; letter-spacing: 0; font-weight: 500; vertical-align: 0.55em; margin-right: 0.15em; }
  .start-vol { font-weight: 700; margin-top: 6px; }
  .copy {
    margin-top: 14px;
    font: inherit; font-size: 0.9rem; font-weight: 700;
    padding: 8px 14px; border-radius: 999px;
    border: 1.5px solid var(--ink); background: var(--sheet); color: var(--ink);
    cursor: pointer;
  }
  .copy:hover { background: var(--ink); color: var(--sheet); }

  .picker {
    margin-top: 16px; padding: 16px 18px; border-radius: 10px;
    border: 1px solid var(--rule); background: var(--paper);
  }
  .picker-title { font-family: var(--display); font-weight: 800; font-size: 1.1rem; }
  .picker-form { margin-top: 8px; }
  .picker-form label { display: block; font-size: 0.92rem; color: var(--ink-soft); margin-bottom: 6px; }
  .picker-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .picker-row input {
    width: 7.5em; font: inherit; font-size: 1.05rem; padding: 8px 12px;
    border: 1.5px solid var(--ink-soft); border-radius: 8px; background: var(--sheet); color: var(--ink);
  }
  .picker-row input:focus { outline: none; border-color: var(--focus); box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus) 30%, transparent); }
  .picker-row button {
    font: inherit; font-weight: 700; font-size: 0.95rem; padding: 8px 16px; border-radius: 8px; cursor: pointer;
    border: none; background: var(--ink); color: var(--sheet);
  }
  .picker-row button:hover { opacity: 0.88; }
  .picker-result { margin-top: 12px; padding: 12px 14px; border-radius: 8px; background: var(--sheet); border-left: 4px solid var(--ribbon); }
  .picker-result strong { font-family: var(--display); font-weight: 800; font-size: 1.15rem; }
  .picker-source { margin-top: 10px; font-size: 0.85rem; color: var(--ink-soft); }
  .callout { margin-top: 16px; padding: 12px 14px; border-radius: 8px; background: var(--amber-bg); color: var(--amber-ink); }

  .facts { margin: 18px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 24px; }
  .facts dt { color: var(--ink-soft); font-size: 0.9rem; }
  .facts dd { margin: 2px 0 0; font-weight: 700; }
  @media (max-width: 480px) { .facts { grid-template-columns: 1fr; } }

  .note { margin-top: 16px; }

  .trust { margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--rule); font-size: 0.92rem; display: grid; gap: 8px; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 8px; vertical-align: 0.05em; }
  .dot.agree { background: #1F9D55; }
  .dot.differ { background: #D99A00; }
  .dot.single { background: transparent; border: 2px solid var(--ink-soft); }
  details summary { cursor: pointer; color: var(--ink-soft); }
  details ul { margin: 8px 0 4px; padding-left: 20px; }
  .small { font-size: 0.85rem; }
  .report { color: var(--ink-soft); justify-self: start; }
</style>

<script>
  // "Stopped partway through?" episode finder.
  type Row = { ep: number; first: number; last: number };
  type Data = { rows: Row[]; firstEpisode: number; unit: string; final: { start: number; volume: number | null; overlap: string | null } };
  document.querySelectorAll<HTMLElement>('.picker').forEach((box) => {
    const data: Data = JSON.parse(box.dataset.picker || '{}');
    const form = box.querySelector('form')!;
    const input = box.querySelector('input')!;
    const out = box.querySelector<HTMLElement>('.picker-result')!;
    const count = data.rows.length;
    const range = (a: number, b: number) => (a === b ? `${data.unit} ${a}` : `${data.unit}s ${a}–${b}`);

    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const n = Number(input.value);
      // Accept the number within the season (1, 2, 3...) or the overall episode number.
      let i = -1;
      if (data.firstEpisode > 1 && n >= data.firstEpisode && n < data.firstEpisode + count) i = n - data.firstEpisode;
      else if (n >= 1 && n <= count) i = n - 1;
      out.hidden = false;
      out.replaceChildren();
      if (i < 0) {
        out.textContent = data.firstEpisode > 1
          ? `This season is episodes ${data.firstEpisode}–${data.firstEpisode + count - 1} (or 1–${count}). Try a number in that range.`
          : `This season has ${count} episodes. Try a number from 1 to ${count}.`;
        return;
      }
      const row = data.rows[i];
      const label = data.firstEpisode > 1 ? `Episode ${data.firstEpisode + i}` : `Episode ${i + 1}`;
      const strong = document.createElement('strong');
      const rest = document.createElement('span');
      if (i === count - 1) {
        strong.textContent = `Start at ${data.unit} ${data.final.start}${data.final.volume ? ` (Volume ${data.final.volume})` : ''}.`;
        rest.textContent = ` That's the season finale, so this matches the answer above.${data.final.overlap ? ` ${data.final.overlap}` : ''}`;
      } else {
        const next = data.rows[i + 1];
        const partial = next.first <= row.last;
        const start = partial ? row.last : row.last + 1;
        strong.textContent = `Start at ${data.unit} ${start}.`;
        rest.textContent = ` ${label} covers ${range(row.first, row.last)}.` +
          (partial ? ` It stops partway through ${data.unit} ${row.last}, so start at the top of it; you'll reread a few pages.` : '');
      }
      out.append(strong, rest);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed. Select the number instead';
      }
      setTimeout(() => (btn.textContent = 'Copy answer'), 2000);
    });
  });
</script>
