---
import { airedLabel, unitLabel } from '../lib/series.mjs';
import { REPO } from '../config.mjs';

const { series, entry } = Astro.props;
const unit = unitLabel(series.source);
const kindText = entry.kind === 'movie' ? 'Film' : entry.episodes ? `Episodes ${entry.episodes}` : '';
const answerText = `${series.title}, after ${entry.label}: start at ${unit} ${entry.start_chapter}${entry.start_volume ? ` (Volume ${entry.start_volume})` : ''}`;

const trust = {
  agree: `${entry.sources.length} sources agree`,
  differ: 'Sources differ slightly, see the note',
  single: 'One source so far. Help us confirm it',
}[entry.confidence];

const checked = new Date(`${entry.last_checked}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const reportUrl = `https://github.com/${REPO}/issues/new?template=correction.yml&title=${encodeURIComponent(`Correction: ${series.title}, ${entry.label}`)}&series=${encodeURIComponent(series.slug)}&entry=${encodeURIComponent(entry.label)}`;
---
<article class="answer" id={entry.id} aria-labelledby={`${entry.id}-h`}>
  <header class="answer-head">
    <h2 id={`${entry.id}-h`}>After {entry.label}</h2>
    <p class="muted">{[kindText, airedLabel(entry.aired)].filter(Boolean).join(', ')}</p>
  </header>

  <div class="start">
    <span class="ribbon" aria-hidden="true"></span>
    <p class="start-label">Start reading at</p>
    <p class="start-number"><span class="unit">{unit}</span> {entry.start_chapter}</p>
    {entry.start_volume && <p class="start-vol">Volume {entry.start_volume}</p>}
    <button class="copy" type="button" data-copy={answerText}>Copy answer</button>
  </div>

  {entry.overlap && (
    <p class="callout"><strong>Where it cuts off:</strong> {entry.overlap}</p>
  )}

  <dl class="facts">
    {entry.last_chapter != null && (<div><dt>Anime ends at</dt><dd>{unit} {entry.last_chapter}</dd></div>)}
    <div><dt>Skipped by the anime</dt><dd>{entry.skipped.length ? entry.skipped.join('; ') : 'Nothing we know of'}</dd></div>
  </dl>

  {entry.note && <p class="note">{entry.note}</p>}

  <div class="trust">
    <p><span class={`dot ${entry.confidence}`} aria-hidden="true"></span>{trust}. Last checked {checked}.</p>
    <details>
      <summary>Sources</summary>
      <ul>
        {entry.sources.map((s) => (<li><a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></li>))}
      </ul>
      <p class="muted small">Source pages may contain spoilers.</p>
    </details>
    <a class="report" href={reportUrl} rel="nofollow">This is wrong</a>
  </div>
</article>

<style>
  .answer {
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 14px;
    padding: 24px;
    margin-top: 20px;
    scroll-margin-top: 16px;
  }
  .answer-head h2 { font-size: 1.3rem; }
  .answer-head p { margin-top: 4px; font-size: 0.95rem; }

  .start {
    position: relative;
    margin: 20px 0 0;
    padding: 22px 22px 20px 64px;
    border-radius: 10px;
    background-color: var(--paper);
    background-image: radial-gradient(var(--tone) 1.1px, transparent 1.3px);
    background-size: 7px 7px;
    overflow: hidden;
  }
  .ribbon {
    position: absolute; left: 22px; top: 0;
    width: 22px; height: 64px;
    background: var(--ribbon);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }
  .start-label { font-weight: 700; }
  .start-number {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(3rem, 12vw, 4.75rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-top: 4px;
  }
  .unit { font-size: 0.42em; letter-spacing: 0; font-weight: 500; vertical-align: 0.55em; margin-right: 0.15em; }
  .start-vol { font-weight: 700; margin-top: 6px; }
  .copy {
    margin-top: 14px;
    font: inherit; font-size: 0.9rem; font-weight: 700;
    padding: 8px 14px; border-radius: 999px;
    border: 1.5px solid var(--ink); background: var(--sheet); color: var(--ink);
    cursor: pointer;
  }
  .copy:hover { background: var(--ink); color: var(--sheet); }

  .callout { margin-top: 16px; padding: 12px 14px; border-radius: 8px; background: var(--amber-bg); color: var(--amber-ink); }

  .facts { margin: 18px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 24px; }
  .facts dt { color: var(--ink-soft); font-size: 0.9rem; }
  .facts dd { margin: 2px 0 0; font-weight: 700; }
  @media (max-width: 480px) { .facts { grid-template-columns: 1fr; } }

  .note { margin-top: 16px; }

  .trust { margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--rule); font-size: 0.92rem; display: grid; gap: 8px; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 8px; vertical-align: 0.05em; }
  .dot.agree { background: #1F9D55; }
  .dot.differ { background: #D99A00; }
  .dot.single { background: transparent; border: 2px solid var(--ink-soft); }
  details summary { cursor: pointer; color: var(--ink-soft); }
  details ul { margin: 8px 0 4px; padding-left: 20px; }
  .small { font-size: 0.85rem; }
  .report { color: var(--ink-soft); justify-self: start; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy || '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed. Select the number instead';
      }
      setTimeout(() => (btn.textContent = 'Copy answer'), 2000);
    });
  });
</script>
