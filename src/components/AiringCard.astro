---
import { airedLabel, unitLabel } from '../lib/series.mjs';
import { REPO } from '../config.mjs';

const { series, entry, hasEarlier } = Astro.props;
const unit = unitLabel(series.source).toLowerCase();
const kindText = entry.kind === 'movie' ? 'Film' : entry.episodes ? `Episodes ${entry.episodes}` : '';
const tipUrl = `https://github.com/${REPO}/issues/new?template=correction.yml&title=${encodeURIComponent(`Finale: ${series.title}, ${entry.label}`)}&series=${encodeURIComponent(series.slug)}&entry=${encodeURIComponent(entry.label)}`;
---
<article class="answer airing" id={entry.id} aria-labelledby={`${entry.id}-h`}>
  <header class="answer-head">
    <h2 id={`${entry.id}-h`}>{entry.label}</h2>
    <p class="muted">{[kindText, `${airedLabel(entry.aired)}, airing now`].filter(Boolean).join(', ')}</p>
  </header>

  <div class="pending">
    <span class="ribbon" aria-hidden="true"></span>
    <p class="pending-title">Still airing</p>
    <p>We'll add the exact {unit} to start within 48 hours of the finale{entry.finale ? `, expected ${entry.finale}` : ''}.</p>
    {hasEarlier && <p class="muted">Catching up first? Earlier seasons are below.</p>}
  </div>

  {entry.note && <p class="note">{entry.note}</p>}

  <p class="tip"><a href={tipUrl} rel="nofollow">Finished it and know the chapter? Tell us</a></p>
</article>

<style>
  .answer {
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 16px;
    padding: clamp(20px, 5vw, 28px);
    box-shadow: var(--shadow);
    margin-top: 20px;
    scroll-margin-top: 16px;
  }
  .answer-head h2 { font-size: 1.4rem; }
  .answer-head p { margin-top: 4px; font-size: 0.95rem; }
  .pending {
    position: relative;
    margin-top: 20px;
    padding: 20px 22px 18px 64px;
    border-radius: 10px;
    border: 1.5px dashed var(--rule);
    display: grid;
    gap: 6px;
  }
  .ribbon {
    position: absolute; left: 22px; top: 0;
    width: 22px; height: 44px;
    background: var(--rule);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }
  .pending-title { font-family: var(--display); font-weight: 800; font-size: 1.6rem; line-height: 1.1; }
  .note { margin-top: 16px; }
  .tip { margin-top: 16px; font-size: 0.92rem; color: var(--ink-soft); }
</style>
